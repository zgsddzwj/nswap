# ============ nswap 环境配置（复制为 .env 使用） ============

# 环境模式: dev=本地开发(允许假openid/跳过微信接口) / prod=生产
ENV=dev

# 数据库连接（本地 docker-compose 的 MySQL）
# 测试环境可用 sqlite: sqlite:///./test.db
DATABASE_URL=mysql+pymysql://nswap:nswap@127.0.0.1:3306/nswap?charset=utf8mb4

# 服务对外可达的基础地址（拼接图片URL、mediaCheck 回调）
# 生产填云托管默认公网域名，如 https://xxx-yyy-xxx.sh.run.tcloudbase.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- 微信接口调用方式 ----
# cloud  = 微信云托管内运行，调 api.weixin.qq.com 免 access_token（生产推荐）
# token  = 自管 access_token（需填 WX_APPID/WX_SECRET）
# mock   = 全部mock直接通过（本地开发默认）
WX_CALL_MODE=mock
WX_APPID=
WX_SECRET=

# 订阅消息模板 ID（微信后台「订阅消息」申请后填入；mock 模式可留空）
MSG_TPL_WANT=
MSG_TPL_ACCEPTED=
MSG_TPL_CONFIRM=
MSG_TPL_REVIEW=

# 管理后台
ADMIN_SESSION_SECRET=please-change-me-to-random-string

# 定时任务（沉底/归档扫描），本地开发可关
ENABLE_SCHEDULER=true

# 图片上传目录
UPLOAD_DIR=./uploads

# ============ 生产化加固（docs/09） ============
# 运行环境标签（Sentry 区分 dev/prod）
ENVIRONMENT=dev

# 图片存储：local=容器本地盘（仅本地开发）/ cos=腾讯云对象存储（生产必须）
# 注意：云托管容器无状态，生产用 local 会导致重启后图片全部丢失
STORAGE_BACKEND=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_CDN_DOMAIN=

# Sentry DSN（留空=不启用，本地开发无需配置）
SENTRY_DSN=

# 限流（生产开启；pytest 自动关闭）
RATE_LIMIT_ENABLED=true

# 协议版本（变更后小程序会要求用户重新同意）
TERMS_VERSION=2026-10
