# nswap Nginx：443 自签名证书过渡站（docs/13 —— 域名/备案就绪前的图片加载方案）
#
# 背景：微信小程序客户端对 <image> 的 http 图片加载有拦截（wx.request/wx.uploadFile
# 在勾选"不校验合法域名"后可走 http，但图片组件不走该豁免）——上传后图片一律无法回显。
# 过渡方案：自签名证书 + IP 的 HTTPS；小程序侧勾选「不校验合法域名、web-view（业务域名）、
# TLS 版本以及 HTTPS 证书」后即可加载。仅限开发调试环境，正式上线必须换备案域名 + 正规证书。
#
# 用法：sudo install -m644 到 /etc/nginx/sites-available/nswap-ssl
#       → sudo ln -sf ../sites-available/nswap-ssl /etc/nginx/sites-enabled/
#       → nginx -t && nginx -s reload
# 证书：openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
#       -keyout /etc/nginx/ssl/nswap-selfsigned.key -out /etc/nginx/ssl/nswap-selfsigned.crt \
#       -subj "/CN=<服务器IP>" -addext "subjectAltName=IP:<服务器IP>"
#
# ⚠️ 前提：云控制台安全组需放行 443 端口

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name 82.157.59.122;

    ssl_certificate     /etc/nginx/ssl/nswap-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/nswap-selfsigned.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location = /nswap {
        return 301 /nswap/admin/;
    }
    location = /nswap/ {
        return 301 /nswap/admin/;
    }
    location /nswap/ {
        rewrite ^/nswap(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
