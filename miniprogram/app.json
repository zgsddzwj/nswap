{
  "pages": [
    "pages/home/home",
    "pages/publish/publish",
    "pages/messages/messages",
    "pages/mine/mine",
    "pages/detail/detail",
    "pages/profile/profile",
    "pages/search/search",
    "pages/publish/edit/edit",
    "pages/verify/verify",
    "pages/wants/wants",
    "pages/chat/chat",
    "pages/trade/trade",
    "pages/review/review",
    "pages/my-items/my-items",
    "pages/favorites/favorites",
    "pages/my-trades/my-trades",
    "pages/agreement/agreement"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navTxt",
    "navigationBarTitleText": "邻里交换",
    "backgroundColor": "@bg",
    "backgroundTextStyle": "@bgTxt"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "assets/tabbar/home.png",
        "selectedIconPath": "assets/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/publish/publish",
        "text": "发布",
        "iconPath": "assets/tabbar/publish.png",
        "selectedIconPath": "assets/tabbar/publish-active.png"
      },
      {
        "pagePath": "pages/messages/messages",
        "text": "消息",
        "iconPath": "assets/tabbar/message.png",
        "selectedIconPath": "assets/tabbar/message-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/tabbar/mine.png",
        "selectedIconPath": "assets/tabbar/mine-active.png"
      }
    ]
  },
  "usingComponents": {
    "t-icon": "tdesign-miniprogram/icon/icon",
    "t-button": "tdesign-miniprogram/button/button",
    "t-input": "tdesign-miniprogram/input/input",
    "t-textarea": "tdesign-miniprogram/textarea/textarea",
    "t-switch": "tdesign-miniprogram/switch/switch",
    "t-popup": "tdesign-miniprogram/popup/popup",
    "t-loading": "tdesign-miniprogram/loading/loading",
    "item-card": "/components/item-card/item-card",
    "filter-bar": "/components/filter-bar/filter-bar",
    "status-badge": "/components/status-badge/status-badge",
    "empty-state": "/components/empty-state/empty-state",
    "want-sheet": "/components/want-sheet/want-sheet"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
