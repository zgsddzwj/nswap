/* ---- 网格卡 ---- */
.ic {
  background: var(--ns-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--ns-shadow-card);
}

.ic--hover { opacity: 0.92; }

.ic__cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
}

.ic__cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.ic__cover--dim {
  filter: grayscale(0.8);
  opacity: 0.65;
}

.ic__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ns-brand-soft);
}

.ic__type {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

.ic__status {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
}

.ic__body {
  padding: 20rpx;
}

.ic__title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ns-ink);
  line-height: 1.45;
  min-height: 82rpx;
}

.ic__price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
  min-height: 44rpx;
}

.ic__big-label {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ic__big-label--sm { font-size: 28rpx; }

.ic__tag {
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.8;
}

.ic__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ns-ink-3);
}

/* ---- 行模式 ---- */
.ic-row {
  display: flex;
  background: var(--ns-card);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: var(--ns-shadow-card);
}

.ic-row--hover { opacity: 0.92; }

.ic-row__cover-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ic-row__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.ic-row__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.ic-row__first {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ic-row__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ns-ink);
  line-height: 1.45;
}

.ic-row__price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 10rpx;
  flex: 1;
}

.ic-row .ic__meta { margin-top: auto; }
