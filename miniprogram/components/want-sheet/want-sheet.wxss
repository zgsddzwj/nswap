.ws {
  background: var(--ns-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

/* 表单区可滚动，提交按钮钉在底部始终可见（用户反馈：提交按钮曾被顶出视野） */
.ws__scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.ws__footer {
  flex: none;
  padding-top: 24rpx;
  background: var(--ns-card);
}

.ws__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ws__close {
  padding: 12rpx;
  margin: -12rpx;
  border-radius: 50%;
}

.ws__close--hover { background: var(--ns-bg); }

.ws__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin: 24rpx 0 12rpx;
}

.ws__label-sub {
  font-weight: 400;
  font-size: 22rpx;
  color: var(--ns-ink-3);
  margin-left: 12rpx;
}

.ws__textarea {
  background: var(--ns-bg) !important;
  border-radius: 16rpx !important;
  padding: 20rpx !important;
}

.ws__bid {
  display: flex;
  align-items: center;
  background: var(--ns-bg);
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 96rpx;
}

.ws__bid__symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ns-ink);
  margin-right: 4rpx;
}

.ws__bid-input,
.ws__swap-input {
  flex: 1;
  background: transparent !important;
}

.ws__swap-input {
  background: var(--ns-bg) !important;
  border-radius: 16rpx !important;
  height: 96rpx !important;
}

.ws__submit {
  margin-top: 8rpx;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 28rpx rgba(14, 122, 90, 0.32);
}

.ws__submit--hover {
  opacity: 0.88;
  transform: scale(0.99);
}

.ws__tip {
  text-align: center;
  margin-top: 16rpx;
}

/* 换物意向附图（我方交换物，≤3 张） */
.ws__images {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.ws__thumb {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.ws__thumb-img {
  width: 100%;
  height: 100%;
}

.ws__thumb-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ws__thumb-add {
  width: 152rpx;
  height: 152rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--ns-line);
  background: var(--ns-bg);
  color: var(--ns-ink-3);
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ws__thumb-add--hover { background: var(--ns-brand-soft); }
.ws__thumb-add--busy { opacity: 0.6; }
