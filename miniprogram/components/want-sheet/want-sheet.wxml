<t-popup visible="{{show}}" placement="bottom" bind:visible-change="onVisibleChange">
  <view class="ws">
    <view class="ws__header">
      <view class="ns-h2">{{itemType === 'want' ? '我可以提供' : '我想要'}}</view>
      <view class="ws__close" hover-class="ws__close--hover" bindtap="onClose">
        <t-icon name="close" size="40rpx" color="var(--ns-ink-2)" />
      </view>
    </view>

    <!-- 表单区：可滚动，保证提交按钮始终钉在弹层底部可见 -->
    <scroll-view class="ws__scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="ws__label">留言 <text class="ws__label-sub">让邻居知道你的诚意</text></view>
      <t-textarea
        value="{{message}}"
        placeholder="例：我家正需要这个，可以明天下午来取"
        maxlength="{{300}}"
        indicator
        autosize="{{ { minHeight: 120, maxHeight: 240 } }}"
        t-class="ws__textarea"
        bind:change="onMessage"
      />

      <block wx:if="{{itemType === 'sell' && negotiable}}">
        <view class="ws__label">出价（可小刀）<text class="ws__label-sub">选填</text></view>
        <view class="ws__bid">
          <text class="ws__bid__symbol">¥</text>
          <t-input
            value="{{bidYuan}}"
            type="digit"
            placeholder="如 12.5"
            borderless
            t-class="ws__bid-input"
            bind:change="onBid"
          />
        </view>
      </block>

      <block wx:if="{{itemType === 'swap'}}">
        <view class="ws__label">我用什么换 <text class="ws__label-sub">选填</text></view>
        <t-input
          value="{{swapOffer}}"
          placeholder="例：我可以用一套绘本交换"
          borderless
          t-class="ws__swap-input"
          bind:change="onSwapOffer"
        />
        <view class="ws__label">附上你想交换的物品照片 <text class="ws__label-sub">选填，最多 3 张</text></view>
        <view class="ws__images">
          <view wx:for="{{images}}" wx:key="*this" class="ws__thumb">
            <image class="ws__thumb-img" src="{{item}}" mode="aspectFill" />
            <view class="ws__thumb-del" data-index="{{index}}" catchtap="onDeleteImage">
              <t-icon name="close" size="24rpx" color="#FFFFFF" />
            </view>
          </view>
          <view wx:if="{{images.length < 3}}" class="ws__thumb-add {{uploading ? 'ws__thumb-add--busy' : ''}}" hover-class="ws__thumb-add--hover" bindtap="onAddImage">
            <text>{{uploading ? '…' : '＋'}}</text>
          </view>
        </view>
      </block>
    </scroll-view>

    <view class="ws__footer">
      <view
        class="ns-btn ns-btn--primary ws__submit {{sending ? 'ns-btn--disabled' : ''}}"
        hover-class="ws__submit--hover"
        bindtap="onSubmit"
      >{{sending ? '提交中…' : '提交意向'}}</view>
      <view class="ns-hint ws__tip">提交后卖家会收到通知，由 TA 自由挑选</view>
    </view>
  </view>
</t-popup>
