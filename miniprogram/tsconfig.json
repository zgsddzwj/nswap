{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true
  },
  "include": ["./typings/index.d.ts", "./config/**/*.ts", "./services/**/*.ts", "./utils/**/*.ts", "./components/**/*.ts", "./pages/**/*.ts", "./app.ts"],
  "exclude": ["node_modules", "miniprogram_npm"]
}
