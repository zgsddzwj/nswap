.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--ns-bg);
}

/* 物品卡 */
.chat__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--ns-card);
  border-bottom: 2rpx solid var(--ns-line);
  flex-shrink: 0;
}

.chat__item--hover { opacity: 0.9; }

.chat__item-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--ns-brand-soft);
  flex-shrink: 0;
}

.chat__item-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat__item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin-bottom: 6rpx;
}

.chat__arrange {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--ns-brand);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.chat__arrange--hover { opacity: 0.85; }

/* 消息列表 */
.chat__list {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat__empty {
  text-align: center;
  padding-top: 120rpx;
}

.chat__empty-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ns-ink);
}

.chat__empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ns-ink-3);
}

.chat__msg-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.chat__msg-wrap--mine { align-items: flex-end; }

.chat__time {
  align-self: center;
  font-size: 20rpx;
  color: var(--ns-ink-3);
  margin-bottom: 16rpx;
}

.chat__msg {
  max-width: 70%;
  padding: 18rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  background: var(--ns-card);
  color: var(--ns-ink);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--ns-shadow-card);
}

.chat__msg--mine {
  background: var(--ns-brand);
  color: #FFFFFF;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
}

.chat__bottom-space { height: 24rpx; }

/* 输入栏 */
.chat__input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--ns-card);
  flex-shrink: 0;
}

.chat__input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ns-bg);
  font-size: 28rpx;
  color: var(--ns-ink);
}

.chat__send {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: var(--ns-brand);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.chat__send--off { opacity: 0.4; }

.chat__send--hover { opacity: 0.85; }

/* 联系方式交换 */
.chat__contact {
  background: var(--ns-card);
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--ns-line);
}

.chat__contact--entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat__contact-row--hover { opacity: 0.8; }

.chat__contact-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ns-ink);
}

.chat__contact-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ns-brand);
  margin-bottom: 12rpx;
}

.chat__contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.chat__contact-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ns-ink);
}

.chat__contact-copy {
  font-size: 24rpx;
  color: var(--ns-brand);
}

.chat__contact-tip { margin-top: 8rpx; }

/* 交换确认弹层 */
.cex {
  background: var(--ns-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.cex__title { margin-bottom: 12rpx; }

.cex__desc {
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.cex__rules {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--ns-bg);
}

.cex__rule {
  font-size: 24rpx;
  color: var(--ns-ink-2);
  line-height: 2;
}

.cex__go { margin-top: 28rpx; }

.cex__go--hover { opacity: 0.85; }

.cex__cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ns-ink-3);
}

.cex__cancel--hover { opacity: 0.7; }
