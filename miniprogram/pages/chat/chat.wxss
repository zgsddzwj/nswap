.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--ns-bg);
}

/* 物品卡 */
.chat__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--ns-card);
  border-bottom: 2rpx solid var(--ns-line);
  flex-shrink: 0;
}

.chat__item--hover { opacity: 0.9; }

.chat__item-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--ns-brand-soft);
  flex-shrink: 0;
}

.chat__item-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat__item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin-bottom: 6rpx;
}

.chat__arrange {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--ns-brand);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.chat__arrange--hover { opacity: 0.85; }

/* 消息列表 */
.chat__list {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat__empty {
  text-align: center;
  padding-top: 120rpx;
}

.chat__empty-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ns-ink);
}

.chat__empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ns-ink-3);
}

.chat__msg-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.chat__msg-wrap--mine { align-items: flex-end; }

.chat__time {
  align-self: center;
  font-size: 20rpx;
  color: var(--ns-ink-3);
  margin-bottom: 16rpx;
}

.chat__msg {
  max-width: 70%;
  padding: 18rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  background: var(--ns-card);
  color: var(--ns-ink);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--ns-shadow-card);
}

.chat__msg--mine {
  background: var(--ns-brand);
  color: #FFFFFF;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
}

.chat__bottom-space { height: 24rpx; }

/* 输入栏 */
.chat__input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--ns-card);
  flex-shrink: 0;
}

.chat__input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ns-bg);
  font-size: 28rpx;
  color: var(--ns-ink);
}

.chat__send {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: var(--ns-brand);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.chat__send--off { opacity: 0.4; }

.chat__send--hover { opacity: 0.85; }
