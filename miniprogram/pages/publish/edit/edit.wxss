.edit {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 图片九宫格 */
.edit__images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 0;
}

.edit__thumb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.edit__thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.edit__thumb-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(17, 24, 32, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit__add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--ns-ink-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--ns-bg);
}

.edit__add--hover { opacity: 0.7; }

.edit__add-text {
  font-size: 22rpx;
  color: var(--ns-ink-3);
}

/* 字段行 */
.edit__field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0;
}

.edit__input {
  flex: 1;
  font-size: 30rpx;
  color: var(--ns-ink);
}

.edit__field-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--ns-ink);
}

.edit__field-name--ph { color: var(--ns-ink-3); }

.edit__divider {
  height: 2rpx;
  background: var(--ns-line);
}

/* 成色胶囊 */
.edit__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 20rpx;
}

.edit__pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ns-ink-2);
  background: var(--ns-bg);
  border: 2rpx solid transparent;
}

.edit__pill--on {
  color: var(--ns-brand);
  background: var(--ns-brand-light);
  border-color: var(--ns-brand);
  font-weight: 600;
}

/* 价格 */
.edit__price {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0 20rpx;
}

.edit__price-symbol {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ns-ink);
}

.edit__price-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ns-ink);
}

.edit__switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
  border-top: 2rpx solid var(--ns-line);
}

.edit__switch-title {
  font-size: 26rpx;
  color: var(--ns-ink);
}

.edit__textarea {
  background: var(--ns-bg) !important;
  border-radius: 16rpx !important;
  padding: 20rpx !important;
}

/* 分类弹层 */
.edit__cat {
  background: var(--ns-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.edit__cat-title {
  margin-bottom: 28rpx;
}

.edit__cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.edit__cat-item {
  width: calc((100% - 40rpx) / 3);
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--ns-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--ns-ink);
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.edit__cat-item--on {
  background: var(--ns-brand-light);
  border-color: var(--ns-brand);
  color: var(--ns-brand);
  font-weight: 600;
}

.edit__cat-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
