<view class="home">
  <!-- 搜索框 -->
  <view class="home__search" hover-class="home__search--hover" bindtap="goSearch">
    <t-icon name="search" size="36rpx" color="var(--ns-ink-3)" />
    <text class="home__search-placeholder">搜索闲置物品</text>
  </view>

  <!-- 双 Tab：本小区 | 同城 -->
  <view class="home__tabs">
    <view class="home__tab {{scope === 'community' ? 'home__tab--on' : ''}}" data-scope="community" bindtap="onScopeTap">
      本小区
      <view wx:if="{{scope === 'community'}}" class="home__tab-line"></view>
    </view>
    <view class="home__tab {{scope === 'city' ? 'home__tab--on' : ''}}" data-scope="city" bindtap="onScopeTap">
      同城
      <view wx:if="{{scope === 'city'}}" class="home__tab-line"></view>
    </view>
  </view>

  <!-- 未验证横幅 -->
  <view wx:if="{{!verified}}" class="home__banner" hover-class="home__banner--hover" bindtap="goVerify">
    <view class="home__banner-icon">
      <t-icon name="notification" size="36rpx" color="var(--ns-want)" />
    </view>
    <view class="ns-grow">
      <view class="home__banner-title">完成小区验证，解锁发布与交换</view>
      <view class="home__banner-sub">邀请码 / 老邻居担保 / 人工审核</view>
    </view>
    <t-icon name="chevron-right" size="40rpx" color="var(--ns-ink-3)" />
  </view>

  <!-- 物业公告卡（仅本小区 Tab） -->
  <view wx:if="{{scope === 'community' && announcement}}" class="home__notice" hover-class="home__banner--hover" bindtap="goAnnouncements">
    <view class="home__notice-tag">公告</view>
    <view class="ns-grow ns-ellipsis home__notice-title">{{announcement.title}}</view>
    <t-icon name="chevron-right" size="36rpx" color="var(--ns-ink-3)" />
  </view>

  <!-- 邻里感谢（仅本小区 Tab，感谢帖已按小区隔离） -->
  <swiper wx:if="{{scope === 'community' && gratitudes.length}}" class="home__gratitudes" display-multiple-items="{{2}}" next-margin="0">
    <swiper-item wx:for="{{gratitudes}}" wx:key="id">
      <view class="grat-card" data-item-id="{{item.item_id}}" bindtap="goGratitude">
        <view class="grat-card__quote">”</view>
        <view class="grat-card__content ns-ellipsis-2">{{item.content}}</view>
        <view class="grat-card__meta ns-ellipsis">{{item.user.building || item.to_building || ''}} {{item.user.nickname}}</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 筛选（同城模式后端忽略楼栋，前端隐藏楼栋选择器） -->
  <filter-bar
    type="{{filters.type}}"
    category="{{filters.category}}"
    building="{{filters.building}}"
    buildings="{{scope === 'community' ? buildings : []}}"
    bind:change="onFiltersChange"
  />

  <!-- 商品双列网格 -->
  <view class="home__grid">
    <block wx:for="{{items}}" wx:key="id">
      <view class="home__cell {{index % 2 === 0 ? 'home__cell--left' : ''}}">
        <item-card item="{{item}}" mode="grid" />
      </view>
    </block>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{firstLoading && !items.length}}" class="home__grid">
    <view class="home__cell" wx:for="{{[0,1,2,3]}}" wx:key="*this">
      <view class="home__skeleton">
        <view class="ns-skeleton home__skeleton-cover"></view>
        <view class="ns-skeleton home__skeleton-line"></view>
        <view class="ns-skeleton home__skeleton-line home__skeleton-line--short"></view>
      </view>
    </view>
  </view>

  <!-- 空态 / 错误态 -->
  <empty-state
    wx:if="{{!firstLoading && !items.length && !loadError && scope === 'community' && !joined}}"
    icon="notification"
    text="加入小区后查看邻里闲置"
    sub="同小区的闲置交换，更安心"
    actionText="去完成小区验证"
    bind:action="goVerify"
  />

  <empty-state
    wx:elif="{{!firstLoading && !items.length && !loadError}}"
    icon="shop"
    text="{{scope === 'community' ? '本小区还没有闲置物品' : '同城暂无闲置物品'}}"
    sub="{{scope === 'community' ? '成为第一个发布的人吧' : '其他小区的小伙伴还没上架，先去发布吧'}}"
    actionText="{{verified ? '去发布' : '先完成小区验证'}}"
    bind:action="onEmptyAction"
  />

  <empty-state
    wx:if="{{loadError}}"
    icon="error-circle"
    text="加载失败"
    sub="网络似乎不太顺畅"
    actionText="重新加载"
    bind:action="onRetry"
  />

  <view wx:if="{{footerText}}" class="ns-list-footer">{{footerText}}</view>
</view>
