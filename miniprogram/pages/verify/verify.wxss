.verify__hero {
  padding: 40rpx 8rpx 32rpx;
}

.verify__hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ns-ink-2);
  line-height: 1.7;
}

.verify__tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.verify__tab {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--ns-card);
  color: var(--ns-ink-2);
  font-size: 28rpx;
  box-shadow: var(--ns-shadow-card);
}

.verify__tab--on {
  background: var(--ns-brand);
  color: #FFFFFF;
  font-weight: 600;
}

.verify__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin: 28rpx 0 12rpx;
}

.verify__code-input {
  height: 108rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  background: var(--ns-bg);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ns-ink);
  text-transform: uppercase;
}

.verify__select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: var(--ns-bg);
  font-size: 28rpx;
  color: var(--ns-ink);
}

.verify__hint {
  margin-top: 16rpx;
  line-height: 1.7;
}

.verify__submit { margin-top: 36rpx; }

/* 人工审核凭证 */
.verify__proof {
  height: 240rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--ns-ink-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--ns-bg);
  padding: 16rpx;
  box-sizing: border-box;
}

.verify__proof--has { border-style: solid; }
.verify__proof--hover { opacity: 0.85; }

.verify__proof-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

/* 已验证 */
.verify__done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  text-align: center;
}

.verify__done-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--ns-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.verify__done-sub { margin-top: 12rpx; }

/* 担保码 */
.verify__vouch { margin-top: 24rpx; }

.verify__vouch-sub {
  margin-top: 8rpx;
  line-height: 1.7;
}

.verify__vouch-btn { margin-top: 24rpx; }

.verify__vouch-err {
  margin-top: 16rpx;
  color: var(--ns-danger);
}

.verify__code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 12rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: var(--ns-brand-soft);
}

.verify__code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ns-brand);
}

.verify__copy {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ns-brand);
}

.verify__copy--hover { opacity: 0.7; }
