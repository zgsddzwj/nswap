.wants__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.wants__item--hover { opacity: 0.9; }

.wants__cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--ns-brand-soft);
  flex-shrink: 0;
}

.wants__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wants__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin-bottom: 8rpx;
}

.wants__tip {
  margin: 24rpx 4rpx;
  font-size: 24rpx;
  color: var(--ns-ink-2);
}

.wants__card {
  margin-bottom: 24rpx;
}

.wants__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--ns-brand-soft);
  margin-right: 16rpx;
}

.wants__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin-right: 12rpx;
}

.wants__badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.wants__status {
  font-size: 24rpx;
  font-weight: 600;
}

.wants__message {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--ns-bg);
  font-size: 27rpx;
  color: var(--ns-ink);
  line-height: 1.6;
}

.wants__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.wants__tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.wants__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wants__actions {
  display: flex;
  gap: 16rpx;
}
