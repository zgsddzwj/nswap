.mine__card {
  padding: 36rpx 32rpx;
}

.mine__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--ns-brand-soft);
  margin-right: 24rpx;
}

.mine__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ns-ink);
}

.mine__badges {
  gap: 12rpx;
  margin-top: 10rpx;
}

.mine__badge {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.mine__badge--plain {
  color: var(--ns-ink-2);
  background: var(--ns-bg);
}

.mine__edit {
  padding: 16rpx;
}

.mine__edit--hover { opacity: 0.7; }

.mine__stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--ns-line);
}

.mine__stat {
  flex: 1;
  text-align: center;
}

.mine__stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ns-ink);
}

.mine__stat-num--warn { color: var(--ns-danger); }

.mine__stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ns-ink-3);
}

.mine__menu { margin-top: 24rpx; padding: 8rpx 0; }

.mine__cell { background: transparent; }

.mine__version {
  text-align: center;
  margin-top: 40rpx;
}

/* 编辑弹层 */
.edit-sheet {
  background: var(--ns-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.edit-sheet__title { margin-bottom: 24rpx; }

.edit-sheet__avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: inherit;
  border: none;
}

.edit-sheet__avatar-btn::after { border: none; }

.edit-sheet__avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--ns-brand-soft);
}

.edit-sheet__avatar-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ns-ink-3);
}

.edit-sheet__label {
  margin: 28rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ns-ink);
}

.edit-sheet__input {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: var(--ns-bg);
  font-size: 28rpx;
  color: var(--ns-ink);
}

.edit-sheet__save { margin-top: 40rpx; }
