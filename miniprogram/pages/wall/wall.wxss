.wall__hero {
  padding: 28rpx 8rpx 24rpx;
}

.wall__hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ns-ink-2);
}

.wall__card {
  margin-bottom: 20rpx;
}

.wall__q-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.wall__pin {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ns-warning-light);
  color: var(--ns-warning);
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1.8;
}

.wall__q-mark,
.wall__a-mark {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.wall__q-mark {
  background: var(--ns-brand);
  color: #ffffff;
}

.wall__a-mark {
  background: var(--ns-bg);
  color: var(--ns-ink-2);
}

.wall__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ns-ink);
  line-height: 1.4;
}

.wall__a-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.wall__content {
  font-size: 27rpx;
  color: var(--ns-ink-2);
  line-height: 1.7;
  white-space: pre-wrap;
}

.wall__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--ns-line);
}

.wall__like {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--ns-bg);
  font-size: 24rpx;
  color: var(--ns-ink-2);
}

.wall__like--on {
  background: var(--ns-danger-light);
  color: var(--ns-danger);
}

.wall__like--hover {
  opacity: 0.75;
}
