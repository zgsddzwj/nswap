.mt__tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mt__tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--ns-card);
  color: var(--ns-ink-2);
  font-size: 26rpx;
  box-shadow: var(--ns-shadow-card);
}

.mt__tab--on {
  background: var(--ns-brand);
  color: #FFFFFF;
  font-weight: 600;
}

.mt__list { min-height: 300rpx; }

.mt__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.mt__row--hover { opacity: 0.9; }

.mt__cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--ns-brand-soft);
  flex-shrink: 0;
}

.mt__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ns-ink);
  margin-right: 12rpx;
  max-width: 320rpx;
}

.mt__cp { margin: 8rpx 0 4rpx; }
