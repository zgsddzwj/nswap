.search__bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.search__field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ns-card);
  box-shadow: var(--ns-shadow-card);
}

.search__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ns-ink);
}

.search__clear {
  padding: 8rpx;
}

.search__clear--hover { opacity: 0.6; }

.search__btn {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ns-brand);
}

.search__btn--hover { opacity: 0.7; }

.search__section { margin-bottom: 16rpx; }

.search__section-head {
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.search__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.search__chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--ns-card);
  box-shadow: var(--ns-shadow-card);
  font-size: 26rpx;
  color: var(--ns-ink-2);
}

.search__chip--hover { opacity: 0.8; }

.search__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.search__cell {
  width: calc(50% - 12rpx);
  margin-bottom: 20rpx;
}
