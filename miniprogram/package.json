    "build:td": "node -e \"const fs=require('fs');fs.cpSync('node_modules/tdesign-miniprogram/miniprogram_dist','miniprogram_npm/tdesign-miniprogram',{recursive:true});console.log('miniprogram_npm/tdesign-miniprogram 已构建')\"",
